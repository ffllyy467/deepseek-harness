# Copy this file to deploy.env (gitignored) and fill in your deployment values.
# deploy/install.sh sources deploy.env if present, then falls back to env vars.
#
#   DSH_TRUSTED_HOSTS      space-separated authorities the /api trust fence
#                          admits on top of loopback — typically the front-door
#                          hostname(s) of the proxy your browser goes through.
#   DSH_WORKSPACE_DEFAULT  absolute path the workspace picker opens at instead
#                          of the host home.
#
# Empty or unset values keep dsh defaults (loopback-only fence, picker at the
# host home). Never commit deploy.env — it may contain deployment hostnames.
DSH_TRUSTED_HOSTS=
DSH_WORKSPACE_DEFAULT=
